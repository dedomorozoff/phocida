{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lfm",
      "camelcase": "Lfm",
      "title": "Lazarus form",
      "scope": "source.lfm",
      "file-types": ["lfm"],
      "injection-regex": "^lfm$",
      "class-name": "TreeSitterLfm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Lazarus form files",
    "authors": [
      {
        "name": "Phocida"
      }
    ]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
